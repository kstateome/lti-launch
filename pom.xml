<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.ksu.ome.lti</groupId>
    <artifactId>lti-launch</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>LTI Launch</name>
    <description>Java framework for authenticating LTI launch requests from the Canvas LMS</description>
    <url>https://github.com/kstateome/lti-launch</url>

    <licenses>
        <license>
            <name>GNU Lesser General Public License (LGPL), Version 3</name>
            <url>http://www.fsf.org/licensing/licenses/lgpl.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <organization>
        <name>Kansas State University, Office of Mediated Education</name>
        <url>http://ome.ksu.edu/</url>
    </organization>

    <developers>
        <developer>
            <name>Toby Murray</name>
            <email>toby@ksu.edu</email>
            <organization>Kansas State University, Office of Mediated Education</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:ssh://git@github.com/kstateome/lti-launch.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/kstateome/lti-launch.git</developerConnection>
        <url>https://github.com/kstateome/lti-launch</url>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>ome-appdev-release</id>
            <url>https://artifactory.ome.k-state.edu/artifactory/ome-appdev-release</url>
        </repository>
        <snapshotRepository>
            <id>ome-appdev-snapshot</id>
            <url>https://artifactory.ome.k-state.edu/artifactory/ome-appdev-snapshot</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <java.version>17</java.version>
        <log4j2.version>2.25.4</log4j2.version>
        <spring.version>6.2.18</spring.version>
        <spring-security.version>6.5.10</spring-security.version>
        <jakarta.servlet-api.version>6.0.0</jakarta.servlet-api.version>
        <canvas-api.version>3.0.0-SNAPSHOT</canvas-api.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <gson.version>2.14.0</gson.version>
        <jstl.version>1.2</jstl.version>
        <junit.version>4.13.2</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <!-- Plugin versions -->
        <maven.compiler.version>3.15.0</maven.compiler.version>
        <maven.enforcer.version>3.6.2</maven.enforcer.version>
        <maven.site.version>3.21.0</maven.site.version>
        <maven.release.version>3.3.1</maven.release.version>
        <maven.surefire.version>3.5.5</maven.surefire.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <maven.source.version>3.4.0</maven.source.version>
        <maven.javadoc.version>3.12.0</maven.javadoc.version>
        <dependency-check-maven.version>12.2.1</dependency-check-maven.version>
        <error_prone_annotations.version>2.48.0</error_prone_annotations.version>
        <!-- Skip integration tests by default. They are enabled by an integration test specific profile -->
        <skipITs>true</skipITs>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check-maven.version}</version>
                <configuration>
                    <failOnError>false</failOnError>
                    <enableNodeAudit>true</enableNodeAudit>
                    <nodeAuditSkipDevDependencies>false</nodeAuditSkipDevDependencies>
                    <scanSet>
                        <fileSet>
                            <directory>${project.basedir}/src/main/passprotect-js</directory>
                            <!-- Only scan the artifacts/config we actually ship/use; exclude node_modules
                                 to avoid reporting CVEs for build tooling dependencies. -->
                            <includes>
                                <include>package.json</include>
                                <include>package-lock.json</include>
                                <include>dist/**</include>
                                <include>js/**</include>
                            </includes>
                            <excludes>
                                <exclude>node_modules/**</exclude>
                                <exclude>test/**</exclude>
                            </excludes>
                        </fileSet>
                    </scanSet>
                    <failBuildOnCVSS>8</failBuildOnCVSS>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                    <failBuildOnCVSS>8</failBuildOnCVSS>
                    <nvdApiKey>${nvd.api.key}</nvdApiKey>
                    <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.version}</version>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-site-plugin</artifactId>
                <version>${maven.site.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${maven.release.version}</version>
                <configuration>
                    <tagNameFormat>@{project.version}</tagNameFormat>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <includes>**/*UTest*.java</includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <executions>
                    <execution>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>integration-test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*ITest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ossrh-deploy</id>
            <distributionManagement>
                <snapshotRepository>
                    <id>ossrh</id>
                    <url>https://oss.sonatype.org/content/repositories/snapshots</url>
                </snapshotRepository>
                <repository>
                    <id>ossrh</id>
                    <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
                </repository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven.gpg.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven.source.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven.javadoc.version}</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>sonar</id>
            <properties>
                <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>${maven.surefire.version}</version>
                        <configuration>
                            <outputDirectory>target/jacoco</outputDirectory>
                            <systemPropertyVariables>
                                <jacoco-agent.destfile>target/jacoco.exec</jacoco-agent.destfile>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco-maven-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>default-instrument</id>
                                <goals>
                                    <goal>instrument</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>default-restore-instrumented-classes</id>
                                <goals>
                                    <goal>restore-instrumented-classes</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>default-report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>org.jacoco</groupId>
                    <artifactId>org.jacoco.agent</artifactId>
                    <classifier>runtime</classifier>
                    <version>${jacoco-maven-plugin.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>integration</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

